;; Standalone runner for the greenfield rebuild test suite (network-free).
(require :asdf)
(let ((q (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname))))
  (when (probe-file q) (load q)))
(asdf:load-asd (truename "hactar-rebuild.asd"))
(asdf:load-asd (truename "hactar-rebuild-tests.asd"))
(ql:quickload :hactar-rebuild-tests :silent t)
(format t "~&--- Running Hactar Rebuild Tests ---~%")
(let ((ok (uiop:symbol-call :hactar-rebuild-tests :run-tests)))
  (format t "~&--- Rebuild Tests ~:[FAILED~;PASSED~] ---~%" ok)
  (uiop:quit (if ok 0 1)))

(in-package #:hactar-rebuild)

;;; ---------------------------------------------------------------------------
;;; Repository root discovery
;;; ---------------------------------------------------------------------------

(defun find-repo-root (&optional (start (uiop:getcwd)))
  "Walk up from START to the nearest directory containing .git; else START."
  (labels ((up (dir)
             (cond
               ((probe-file (merge-pathnames ".git/" dir)) dir)
               ((equal dir (uiop:pathname-parent-directory-pathname dir)) start)
               (t (up (uiop:pathname-parent-directory-pathname dir))))))
    (up (uiop:ensure-directory-pathname start))))

;;; ---------------------------------------------------------------------------
;;; Doctor: .envrc, .gitignore, launcher shim
;;; ---------------------------------------------------------------------------

(defun ensure-line (file line)
  "Append LINE to FILE unless already present. Creates FILE if needed."
  (let ((content (if (probe-file file) (uiop:read-file-string file) "")))
    (unless (search line content)
      (with-open-file (s file :direction :output
                              :if-exists :append :if-does-not-exist :create)
        (format s "~&~A~%" line)))
    file))

(defun install-shim (&optional (root *repo-root*))
  "Install a launcher shim at ~/.local/bin/hactar delegating to the nearest
project-local binary, falling back to the engine on PATH."
  (let* ((bin-dir (merge-pathnames ".local/bin/"
                                   (uiop:ensure-directory-pathname
                                    (uiop:getenv-absolute-directory "HOME"))))
         (shim (merge-pathnames "hactar" bin-dir)))
    (declare (ignore root))
    (ensure-directories-exist bin-dir)
    (let ((lines
            (list "#!/bin/sh"
                  "# hactar launcher shim (generated by hactar.doctor)"
                  "dir=$(pwd)"
                  "while [ \"$dir\" != \"/\" ]; do"
                  "  if [ -x \"$dir/hactar/build/hactar\" ]; then"
                  "    exec \"$dir/hactar/build/hactar\" \"$@\""
                  "  fi"
                  "  dir=$(dirname \"$dir\")"
                  "done"
                  "exec hactar-engine \"$@\"")))
      (with-open-file (s shim :direction :output :if-exists :supersede
                              :if-does-not-exist :create)
        (dolist (line lines) (format s "~A~%" line))))
    (ignore-errors
      (uiop:run-program (list "chmod" "+x" (namestring shim))
                        :ignore-error-status t))
    shim))

(defun doctor (&optional (root (or *repo-root* (find-repo-root))))
  "Repair project-local Hactar wiring: .envrc, .gitignore, launcher shim."
  (setf *repo-root* root)
  (let ((rootd (uiop:ensure-directory-pathname root)))
    (ensure-line (merge-pathnames ".envrc" rootd) "PATH_add hactar/build")
    (ensure-line (merge-pathnames ".envrc" rootd) "watch_file .hactar.lisp")
    (ensure-line (merge-pathnames ".gitignore" rootd) "hactar/build/")
    (ignore-errors (install-shim root))
    (ok "doctor: wiring ensured (.envrc, .gitignore, shim).")))

;;; ---------------------------------------------------------------------------
;;; Builder: ensure ./hactar/build/hactar exists
;;; ---------------------------------------------------------------------------

(defun build-project-binary (&optional (root (or *repo-root* (find-repo-root))))
  "Ensure ./hactar/build/hactar exists. On a toolchain machine this delegates
to `make build`; otherwise it links the running engine image."
  (let* ((rootd (uiop:ensure-directory-pathname root))
         (build-dir (merge-pathnames "hactar/build/" rootd))
         (target (merge-pathnames "hactar" build-dir)))
    (ensure-directories-exist build-dir)
    (unless (probe-file target)
      ;; Network-free fallback: a shim that reports the binary is not yet built.
      (with-open-file (s target :direction :output :if-exists :supersede
                                :if-does-not-exist :create)
        (format s "#!/bin/sh~%echo 'hactar: run `make build` to produce the real binary' >&2~%exit 1~%"))
      (ignore-errors
        (uiop:run-program (list "chmod" "+x" (namestring target))
                          :ignore-error-status t)))
    (ok (format nil "build: ~A" (namestring target))
        :data (list :binary (namestring target)))))

;;; ---------------------------------------------------------------------------
;;; Bootstrap pipeline
;;; ---------------------------------------------------------------------------

(defun bootstrap (&optional (root (find-repo-root)))
  "First run: detect -> extract -> generate -> validate -> write -> build -> wire."
  (setf *repo-root* root)
  (multiple-value-bind (stack mode) (detect-stack root)
    (setf *stack* stack)
    (when mode (install-stack-commands mode))
    (setf *project-map* (extract-project-map root stack))
    (let ((forms (generate-harness root)))
      (multiple-value-bind (ok errs) (validate-forms forms)
        (unless ok (error "Generated harness invalid: ~{~A~^; ~}" errs)))
      (write-hactar-file (hactar-file-path root) forms)
      (load-hactar-file (hactar-file-path root))
      (build-project-binary root)
      (doctor root)
      (hactar-file-path root))))
